// Code signing and optimisation for the FWPlayer target.
//
// Put your Apple Developer team ID in Config/Local.xcconfig (git-ignored; copy
// Local.xcconfig.example) and it is picked up here. Keeping it out of the project
// file means `git pull` never conflicts with the team you chose in Xcode.
#include? "Local.xcconfig"

// Optimise Debug builds too. DSD conversion (DoP packing, DSD → PCM) and the DST
// decoder are tight loops over hundreds of MB; at -Onone they take minutes and the
// player just shows a spinner. (Personal app: stepping through code isn't the point.)
SWIFT_OPTIMIZATION_LEVEL = -O
GCC_OPTIMIZATION_LEVEL = 3
