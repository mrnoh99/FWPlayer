        }
      }
    },
    "Add Folder…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 추가…"
          }
        }
      }
    },
    "Add SMB Server": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SMB 서버 추가"
          }
        }
      }
    },
    "Add SMB Server…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SMB 서버 추가…"
          }
        }
      }
    },
    "Add to Favorites": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾기에 추가"
          }
        }
      }
    },
    "Add to Playlist": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플레이리스트에 추가"
